<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="larder"
        Arguments=""
        InstallLocation="C:\Program Files\Larder contributors\Larder">
    </Installer>
    <PackageInformation
        PackageName="Larder"
        PackageDisplayName="Larder"
        PublisherName="CN=Larder contributors"
        PublisherDisplayName="Larder contributors"
        Version="0.0.3.0"
        PackageDescription="Local Skills, MCP and CLI manager">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.larder.app"
                Description="Local Skills, MCP and CLI manager"
                DisplayName="Larder"
                ExecutableName="larder"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Larder</DisplayName>
            <PublisherDisplayName>Larder contributors</PublisherDisplayName>
            <Description>Local Skills, MCP and CLI manager</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="larder.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
